    "./lib/config-lock.js": "./lib/config-lock.js",
    "./lib/semantic.js": "./lib/semantic.js",
    "./lib/redact.js": "./lib/redact.js",
    "./gates/default.json": "./gates/default.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-gate": "bin/gate.mjs"
